# --------------------------------------------------------------------------- #
# WhatsApp Bot — environment configuration
# Copy this file to `.env` and fill in real values.
#
# `Settings` (app/core/config.py) reads from .env; missing values fall back to
# safe defaults that are NOT suitable for production. Anything here marked
# `change_me_*` MUST be replaced before going live.
# --------------------------------------------------------------------------- #

# ----- App ---------------------------------------------------------------- #
APP_NAME=WhatsApp Bot
DEBUG=False
WEB_BASE_URL=http://localhost:8000

# ----- Database ----------------------------------------------------------- #
# SQLite for dev (default). Postgres recommended in production.
DATABASE_URL=sqlite:///./whatsapp_bot.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/whatsapp_bot

# ----- WhatsApp Cloud API ------------------------------------------------- #
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_VERIFY_TOKEN=change_me_to_a_random_string
WHATSAPP_TOKEN=meta_long_lived_access_token
WHATSAPP_PHONE_ID=numeric_phone_number_id
# App Secret enables HMAC signature verification on inbound webhooks.
# Set this in production. If empty, signature verification is skipped (dev only).
WHATSAPP_APP_SECRET=

# ----- Admin -------------------------------------------------------------- #
# X-Admin-Key value used for /admin/* JSON endpoints AND the /admin-ui panel.
ADMIN_API_KEY=change_me_admin_key

# ----- AI ----------------------------------------------------------------- #
# Required for the agent to function and for memory summarization / Whisper.
OPENAI_API_KEY=

# Google Gemini key — used by text_to_image and image_to_image tools.
# https://aistudio.google.com/
GOOGLE_CLOUD_API_KEY=

# ----- Redis -------------------------------------------------------------- #
REDIS_URL=redis://localhost:6379/0

# ----- Rate limiting ------------------------------------------------------ #
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# ----- Per-user message queue (deduplicates rapid messages) -------------- #
USER_QUEUE_ENABLED=True
USER_QUEUE_TTL=120
USER_QUEUE_MAX_SIZE=10

# ----- Web auth (phone+OTP -> JWT cookie) -------------------------------- #
# IMPORTANT: change JWT_SECRET in production. It also keys the obfuscated
# OAuth-token storage in `app/web/crypto.py`, so rotating it invalidates
# previously stored integrations.
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALG=HS256
JWT_TTL_MINUTES=10080
OTP_TTL_SECONDS=300
AUTH_COOKIE_NAME=wa_session

# ----- Stripe billing (optional) ----------------------------------------- #
# When STRIPE_SECRET_KEY is empty, the app runs in MOCK billing mode:
# /checkout/start?plan=pro upgrades the user instantly without charging.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# Cosmetic display labels on /pricing
PRICE_FREE_LABEL=$0/mo
PRICE_PRO_LABEL=$9/mo
PRICE_MAX_LABEL=$29/mo

# ----- Google OAuth (Gmail integration) ---------------------------------- #
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to f"{WEB_BASE_URL}/integrations/google/callback" if blank.
GOOGLE_OAUTH_REDIRECT_URI=
